# PromptX environment
#
# Copy to .env.local for development. .env.local is git-ignored and must stay
# that way — this file is the only env file that is ever committed.
#
# Two rules that are one-way doors:
#   1. Only genuinely public values carry NEXT_PUBLIC_. Adding that prefix to a
#      secret ships it to every browser.
#   2. NEXT_PUBLIC_* is inlined at BUILD time, not read at runtime. Changing one
#      on Render requires a rebuild, not a restart. Forgetting this produces an
#      OAuth redirect to the old URL with no error to explain it.


# ─── Public ───────────────────────────────────────────────────────────────

# Supabase project URL. Public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key, format `sb_publishable_…`. Safe to expose — RLS is the
# protection, not this key's secrecy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# OAuth redirect target and share-link base. In production this is the Render
# URL (https://<service>.onrender.com) or the custom domain. Must be correct
# BEFORE the build that ships.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Per-user shared-key allowance, resetting at 00:00 UTC. Public because the
# composer displays it: an unprefixed read would be undefined in the browser
# and silently fall back to the default while the server enforced the real cap.
#
# 5, not the 20 the design first assumed. Google's free tier grants 20 requests
# a day across ALL users rather than per user, so a single visitor on a
# 20-message allowance would spend the entire project's daily quota and everyone
# after them would be refused by Google instead of by PromptX. Raise this only
# alongside a key whose provider-side limit can actually support it.
NEXT_PUBLIC_SHARED_KEY_DAILY_MESSAGE_LIMIT=5

# Global monthly ceiling in USD. Breaching it trips the circuit breaker for
# every keyless user.
NEXT_PUBLIC_SHARED_KEY_MONTHLY_USD_CEILING=10


# ─── Secret — never prefixed NEXT_PUBLIC_, never committed ────────────────

# Format `sb_secret_…`. Assumes service_role and bypasses RLS entirely, which
# is why only src/server/quota.ts may reach a client built from it.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
# Rotating this invalidates every stored user API key, so rotation needs a
# re-encryption migration rather than just a new value.
ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# The billed Google key behind the shared Gemini fallback. Consumed only in
# src/server/providers.ts. Set a hard budget cap on the Google Cloud billing
# account backing it — the in-app circuit breaker is best-effort.
SHARED_GEMINI_API_KEY=your_google_ai_api_key


# ─── Injected by the platform ─────────────────────────────────────────────
#
# PORT — Render sets this and `next start` binds it automatically. Never set
# it manually.
