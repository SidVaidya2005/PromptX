# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every real one stays local. The example is the documented
# contract for what must be set, so it is the one exception.
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-cli scratch output — snapshots and console logs written by the
# browser debugging skill every time a UI feature is verified. Not the e2e
# suite, which arrives at feature 36 and lives in e2e/.
.playwright-cli/
